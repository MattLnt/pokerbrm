// Schéma Prisma — App poker BRM
// Mono-utilisateur au départ, mais tout est rattaché à un userId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TournamentFormat {
  CLASSIC
  KO
  MYSTERY
  SPACE_KO
  /// Plus proposé à la saisie : le joueur ne suit pas les Spins. Conservé
  /// parce que des tournois importés en portent encore le format.
  SPIN
}

enum TournamentSpeed {
  NORMAL
  SEMITURBO // Winamax expose cette vitesse, vue sur 502 tournois réels
  TURBO
  HYPER
}

enum TournamentSource {
  IMPORT
  MANUAL
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  RAKEBACK
  BONUS
  TICKET
  ADJUSTMENT
  /// Transfert entre deux rooms. Toujours par paire : la bankroll totale ne
  /// bouge pas, seuls les deux soldes changent.
  TRANSFER_IN
  TRANSFER_OUT
}

enum StudySessionType {
  THEORIE
  DRILL
  REVUE_MAINS
  REVUE_BDD
}

enum TaggedHandStatus {
  A_REVOIR
  REVUE
}

/// Sens d'un mouvement du compte bancaire. Le montant est toujours saisi en
/// positif : c'est le sens qui dit s'il s'ajoute ou se retranche.
enum BankFlow {
  INCOME
  EXPENSE
}

/// Où en est un projet web. Les trois premiers états sont le vivier — un
/// projet qui n'est pas encore du travail —, `EN_COURS` et `TERMINE` sont le
/// travail réel.
enum ProjectStage {
  /// Piste identifiée, aucun devis envoyé.
  IDEE
  DEVIS_ENVOYE
  DEVIS_REFUSE
  EN_COURS
  TERMINE
}

/// Où en est l'argent d'un projet. Indépendant de l'avancement : un projet
/// terminé peut rester à facturer, un projet en cours peut être payé d'avance.
enum ProjectBilling {
  A_FACTURER
  FACTURE
  PAYE
}

/// Les trois emplois d'une journée, les seuls que l'agenda planifie. Chacun
/// porte sa couleur dans l'interface (`PLAN_KINDS`, lib/constants.js).
enum PlanKind {
  /// Jeu : de l'heure de lancement du premier tournoi à la fin du grind.
  GRIND
  /// Travail de stratégie : théorie, drills, revue de mains.
  ETUDE
  /// Les projets web.
  PROJET
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  createdAt DateTime @default(now())

  sites          Site[]
  tournaments    Tournament[]
  transactions   Transaction[]
  importBatches  ImportBatch[]
  templates      TournamentTemplate[]
  sessions       Session[]
  ranges         Range[]
  studyThemes    StudyTheme[]
  studySessions  StudySession[]
  taggedHands    TaggedHand[]
  drillAttempts  DrillAttempt[]
  settings       Settings?
  bankEntries      BankEntry[]
  recurringCharges RecurringCharge[]
  projects         Project[]
  projectAccesses  ProjectAccess[]
  planBlocks       PlanBlock[]
}

model Site {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String // Winamax, PokerStars, PMU
  slug         String // winamax, pokerstars, pmu
  lastImportAt DateTime?

  tournaments  Tournament[]
  transactions Transaction[]
  templates    TournamentTemplate[]

  @@unique([userId, slug])
}

model Tournament {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  externalId     String
  name           String
  playedAt       DateTime
  buyIn          Decimal          @db.Decimal(12, 2)
  fee            Decimal          @db.Decimal(12, 2)
  bounty         Decimal          @default(0) @db.Decimal(12, 2)
  reEntries      Int              @default(0)
  entrants       Int?
  finishPosition Int?
  prize          Decimal          @default(0) @db.Decimal(12, 2)
  bountiesWon    Decimal          @default(0) @db.Decimal(12, 2)
  totalCost      Decimal          @db.Decimal(12, 2)
  netResult      Decimal          @db.Decimal(12, 2)
  format         TournamentFormat @default(CLASSIC)
  speed          TournamentSpeed  @default(NORMAL)
  /// Durée d'un niveau de blindes, en minutes. Lue dans le résumé Winamax.
  levelMinutes   Int?
  currency       String           @default("EUR")
  importBatchId  String?
  importBatch    ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  // Saisie en direct pendant une session
  source     TournamentSource    @default(IMPORT)
  inProgress Boolean             @default(false)
  sessionId  String?
  session    Session?            @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  templateId String?
  template   TournamentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([siteId, externalId])
  @@index([userId, playedAt])
  @@index([userId, format])
  @@index([userId, sessionId])
}

/// Modèle de tournoi de la grille : ce que le joueur joue habituellement.
/// Sert à inscrire un tournoi en un tap pendant une session — le buy-in, le
/// rake, la prime et le format viennent de là, il ne reste que le résultat
/// à saisir à la sortie.
model TournamentTemplate {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  buyIn     Decimal          @db.Decimal(12, 2)
  fee       Decimal          @db.Decimal(12, 2)
  bounty    Decimal          @default(0) @db.Decimal(12, 2)
  format    TournamentFormat @default(CLASSIC)
  speed     TournamentSpeed  @default(NORMAL)
  /// Durée d'un niveau de blindes, en minutes.
  levelMinutes Int?
  /// Étiquette libre : « Event », « Série », … Sert à distinguer les
  /// rendez-vous ponctuels des tournois réguliers sans les supprimer.
  tag       String?
  /// Heure habituelle de lancement, pour remonter les bons tournois en tête
  /// de grille au moment où on joue.
  usualHour Int?
  /// Minute de lancement, au quart d'heure (0, 15, 30, 45). L'heure seule ne
  /// suffisait pas : beaucoup de tournois partent à la demie, et deux
  /// tournois d'une même tranche ne se jouent pas au même moment.
  usualMinute Int?
  position  Int              @default(0)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())

  entries Tournament[]

  // Pas de clé d'unicité : une room fait tourner le même tournoi plusieurs
  // fois par jour, au même buy-in. Deux « MYSTERY KO 10 € », l'un à 11 h et
  // l'autre à 14 h, sont deux lignes de grille légitimes.
  @@index([userId, active, position])
}

/// Une session de jeu : la fenêtre pendant laquelle on inscrit des tournois.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  note      String?

  tournaments Tournament[]

  @@index([userId, startedAt])
}

model ImportBatch {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  fileCount      Int      @default(0)
  newCount       Int      @default(0)
  duplicateCount Int      @default(0)

  tournaments Tournament[]
}

model Transaction {
  id     String          @id @default(cuid())
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId String
  site   Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type   TransactionType
  amount Decimal         @db.Decimal(12, 2)
  date   DateTime
  note   String?
  /// Relie les deux moitiés d'un transfert entre rooms, pour les afficher et
  /// les défaire ensemble. NULL partout ailleurs.
  transferId String?

  @@index([userId, date])
  @@index([userId, transferId])
}

// Les paliers de buy-in ne sont pas en base : ils vivent dans
// `PALIERS_BUYIN` (lib/constants.js). La stratégie de bankroll est une règle
// du joueur, la même pour toute l'app — pas une donnée à éditer écran par
// écran, et rien ne la modifie à l'exécution.

model Range {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  position    String // UTG, UTG1, MP, HJ, CO, BTN, SB, BB
  action      String // RFI, DEF_VS_OPEN, 3BET, VS_3BET, SHOVE, CALL_SHOVE
  // Chaîne vide plutôt que NULL : en Postgres, deux NULL ne violent pas une
  // contrainte unique, ce qui casserait la déduplication des spots.
  vsPosition  String   @default("")
  stackDepth  String // 60BB_PLUS, 40BB, 25BB, 15_20BB, SUB_12BB
  cells       Json // { "AKs": { "raise": 60, "call": 40 }, ... }
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  drillAttempts DrillAttempt[]

  @@unique([userId, position, action, vsPosition, stackDepth])
}

model StudyTheme {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  block     String?
  weekFrom  Int?
  weekTo    Int?
  position  Int      @default(0)
  objectives Json    @default("[]") // [{ label, done }]
  createdAt DateTime @default(now())

  sessions StudySession[]

  @@index([userId, position])
}

model StudySession {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId String?
  theme   StudyTheme?      @relation(fields: [themeId], references: [id], onDelete: SetNull)
  date    DateTime
  minutes Int
  type    StudySessionType
  notes   String?

  @@index([userId, date])
}

model TaggedHand {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  spot        String
  stackDepth  String?
  description String?
  handHistory String?
  link        String?
  status      TaggedHandStatus @default(A_REVOIR)
  createdAt   DateTime         @default(now())

  @@index([userId, status])
}

model DrillAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rangeId   String
  range     Range    @relation(fields: [rangeId], references: [id], onDelete: Cascade)
  hand      String
  answer    String
  correct   Boolean
  createdAt DateTime @default(now())

  // répétition espacée (SM-2 simplifié)
  easiness   Float    @default(2.5)
  interval   Int      @default(0)
  repetition Int      @default(0)
  dueAt      DateTime @default(now())

  @@index([userId, dueAt])
  @@index([userId, rangeId])
}

model Settings {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyStudyDays  Int     @default(5)
  dailyStudyMinutes Int    @default(75)
  importStaleDays  Int     @default(7)

  /// Solde du compte bancaire au jour `bankOpeningAt`. Les mouvements ne
  /// remontent pas jusqu'à l'ouverture du compte : sans point de départ, le
  /// solde affiché ne serait que la somme de ce qui a été saisi ici.
  bankOpeningBalance Decimal   @default(0) @db.Decimal(12, 2)
  bankOpeningAt      DateTime?
}

/* ------------------------------------------------------------------ */
/* Compte bancaire                                                     */
/* ------------------------------------------------------------------ */

/// Un mouvement saisi à la main sur le compte bancaire.
///
/// Les retraits et dépôts poker n'ont **pas** de ligne ici : ils vivent dans
/// `Transaction` et le compte les reflète à la lecture (lib/compte.js). Un
/// retrait recopié en base serait une seconde vérité à tenir à jour, et la
/// moindre correction côté bankroll ferait divergence.
model BankEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  label     String
  /// Toujours positif : `flow` porte le sens.
  amount    Decimal  @db.Decimal(12, 2)
  flow      BankFlow
  /// Clé d'une catégorie de `CATEGORIES_COMPTE` (lib/constants.js). Les
  /// catégories sont une nomenclature, pas une donnée à éditer écran par
  /// écran — même parti pris que les paliers de buy-in.
  category  String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

/// Une charge qui retombe chaque mois : loyer, abonnements, assurance.
///
/// Elle n'engendre aucun mouvement automatiquement — l'app ne sait pas si le
/// prélèvement est passé. Elle sert à connaître le montant des charges fixes,
/// donc ce qui reste réellement disponible une fois le mois payé.
model RecurringCharge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  amount     Decimal  @db.Decimal(12, 2)
  category   String
  /// Jour du mois du prélèvement (1–31), s'il est connu.
  dayOfMonth Int?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId, active])
}

/* ------------------------------------------------------------------ */
/* Projets web                                                         */
/* ------------------------------------------------------------------ */

/// Un projet web, du vivier à l'encaissement.
///
/// Un seul montant par projet, et non des jalons : la facturation se fait en
/// une fois. `stage` suit l'avancement, `billing` suit l'argent — les deux ne
/// marchent pas au même rythme.
model Project {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  client    String?
  /// Montant à facturer, en euros. `0` pour une piste dont le prix n'est pas
  /// encore fixé.
  amount    Decimal        @default(0) @db.Decimal(12, 2)
  stage     ProjectStage   @default(IDEE)
  billing   ProjectBilling @default(A_FACTURER)
  /// Date d'envoi du devis. C'est elle qui distingue « devis envoyé, sans
  /// réponse depuis trois semaines » de « devis parti hier ».
  devisAt   DateTime?
  invoicedAt DateTime?
  /// Date d'encaissement. Avec `billing = PAYE`, elle fait naître l'entrée
  /// correspondante sur le compte bancaire.
  paidAt    DateTime?
  /// Échéance de livraison, si elle est engagée.
  deadline  DateTime?
  url       String?
  note      String?
  position  Int            @default(0)
  createdAt DateTime       @default(now())

  accesses   ProjectAccess[]
  planBlocks PlanBlock[]

  @@index([userId, stage, position])
}

/// Quel compte, chez quel service, pour quel projet.
///
/// Références seulement : service, compte utilisé, nom de la ressource, lien
/// vers le tableau de bord. **Aucun secret** — ni mot de passe, ni clé d'API,
/// ni chaîne de connexion. La base de l'app n'est pas un coffre-fort : elle
/// n'est pas chiffrée au repos côté application, et ses sauvegardes se
/// promènent. Les secrets restent dans un gestionnaire dédié.
model ProjectAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NULL pour un accès qui ne dépend d'aucun projet : le compte GitHub
  /// personnel, le registrar où dorment tous les domaines.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Slug d'un service de `SERVICES_WEB` (lib/constants.js).
  service   String
  /// Le compte utilisé : une adresse e-mail, un identifiant d'organisation.
  account   String?
  /// Le nom de la ressource chez ce service : projet Vercel, base Railway,
  /// compte Stripe, domaine.
  resource  String?
  url       String?
  note      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, projectId, position])
}

/* ------------------------------------------------------------------ */
/* Agenda                                                              */
/* ------------------------------------------------------------------ */

/// Un créneau planifié dans la journée : grind, étude ou projet web.
///
/// C'est une **intention**, pas un relevé. Les heures réellement jouées
/// vivent dans `Session` et `Tournament`, les minutes réellement étudiées
/// dans `StudySession` — l'agenda ne les recopie pas et ne se met pas à jour
/// tout seul quand une session dérape. Les deux lectures servent à des
/// choses différentes : ce qu'on a prévu, ce qu'on a fait.
model PlanBlock {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Le jour du créneau, sans heure. `@db.Date` et non un horodatage : un
  /// jour d'agenda n'a pas de fuseau, et une `TIMESTAMP` glisserait d'un jour
  /// selon l'endroit où elle est lue.
  date   DateTime @db.Date
  kind   PlanKind
  /// Minutes depuis minuit. `endMinute` peut dépasser 1440 : un grind
  /// terminé à 2 h appartient à la soirée qui l'a commencé, pas au lendemain
  /// matin. Toujours `startMinute < endMinute`.
  startMinute Int
  endMinute   Int
  /// Pour un créneau de projet web : lequel. Facultatif — on bloque souvent
  /// une plage de travail avant de savoir sur quoi elle passera.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime @default(now())

  // Pas de contrainte d'unicité : deux créneaux du même type dans la même
  // journée sont légitimes — un grind du matin et un grind du soir.
  @@index([userId, date])
}
